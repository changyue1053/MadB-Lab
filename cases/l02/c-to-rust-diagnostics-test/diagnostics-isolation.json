  "assertions": [
    {
      "observation": "candidate.binding",
      "operator": "equals",
      "expected": [
        {
          "kind": "string",
          "value": "Every real SDK process loads the fixed installed candidate library, emits that image interface/profile identity and its actual process identity, and ends with its exact successful completion record; helper stubs remain explicitly stub-only."
        }
      ]
    },
    {
      "observation": "capture.equivalence",
      "operator": "equals",
      "expected": [
        {
          "kind": "string",
          "value": "Each of operation-close, source-lease, self-wait and fault-isolation executes independently with capture off, on, and on after queue saturation. Diagnostic mode does not disable admission, ownership, SourceLease, callback reentrancy or close/drain protection."
        }
      ]
    },
    {
      "observation": "operation-close.barrier",
      "operator": "equals",
      "expected": [
        {
          "kind": "string",
          "value": "A public companion gate holds an admitted checksum. After request_close, zero-budget await_closed returns TIMEOUT and release returns BUSY while the operation remains held. Resume and join complete the original checksum with sum 6; then await_closed succeeds and release succeeds."
        }
      ]
    },
    {
      "observation": "source-lease.barrier",
      "operator": "equals",
      "expected": [
        {
          "kind": "string",
          "value": "A public companion gate holds a source lease. Close cannot finish and release is BUSY while held; context remains live. After resume and join, the second callback has completed, await_closed succeeds, and a later source emit returns CLOSED without another callback. Context retirement and handle release follow drain."
        }
      ]
    },
    {
      "observation": "self-wait.reentrant",
      "operator": "equals",
      "expected": [
        {
          "kind": "string",
          "value": "A callback requesting its engine close cannot await itself: WOULD_DEADLOCK is returned. Observe returns CLOSING with zero subscription and exactly one callback; outside await_closed confirms completion before context retirement and engine release."
        }
      ]
    },
    {
      "observation": "fault-isolation.business",
      "operator": "equals",
      "expected": [
        {
          "kind": "string",
          "value": "Existing test fault 3 is enabled around the ordinary sequence: diagnostic_failures increases, while checksum 511, invalid-handle output zeroing, one synchronous callback and confirmed close/release remain unchanged. Clear the test fault before final companion snapshot."
        }
      ]
    },
    {
      "observation": "companion.resources",
      "operator": "equals",
      "expected": [
        {
          "kind": "string",
          "value": "For operation-close, source-lease and fault-isolation, actual public companion snapshots establish paired engine/subscription creation and release, restored registry/active-operation/source-lease counts, and equal started/finished callbacks. Raw output exposes the independently checked boolean resource_balance and context_released_after_drain; reports must not invent numeric observations absent from raw output."
        }
      ]
    }
  ],

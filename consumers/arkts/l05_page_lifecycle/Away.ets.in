import { owner } from '../ApplicationOwner';
import { failed, complete } from '../Trace';
@Entry
@ComponentV2
struct Away {
  @Local phase: string = 'DRAINING';
  @Local pageId: number = 0;
  @Local ordinaryCount: number = 0;
  aboutToAppear(): void {
    owner.destroyedPage().then((page) => {
      this.pageId = page.id; this.ordinaryCount = owner.ordinaryCount; this.phase = 'AWAY_READY_' + String(page.id);
    }).catch(failed);
  }
  build() {
    Column({ space: 16 }) {
      Text('L05 page was destroyed').id('l05-life-title')
      Text(this.phase).id('l05-life-phase')
      Text(String(this.pageId)).id('l05-life-page-id')
      Text(String(this.ordinaryCount)).id('l05-life-ordinary')
      Button('Publish after destruction').id('l05-life-after-publish').onClick(() => {
        owner.publishAfterDestroy().then(() => {
          this.ordinaryCount = owner.ordinaryCount; this.phase = 'AWAY_PUBLISHED_' + String(this.pageId);
        }).catch(failed);
      })
      if (this.pageId < 3) {
        Button('Create new page').id('l05-life-new-page').onClick(() => {
          owner.destroyedPage().then(() => {
            this.getUIContext().getRouter().replaceUrl({ url: 'pages/Index' }).catch(failed);
          }).catch(failed);
        })
      } else {
        Button('Finish').id('l05-life-finish').onClick(() => {
          owner.finish().then(() => { this.phase = 'FINISHED'; complete(); }).catch(failed);
        })
      }
    }.width('100%').height('100%').justifyContent(FlexAlign.Center)
  }
}

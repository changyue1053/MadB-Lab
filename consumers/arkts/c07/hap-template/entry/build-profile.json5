{
  "apiType": "stageMode",
  "targets": [
    {
      "name": "default"
    }
  ],
  "buildOption": {
    "nativeLib": {
      "debugSymbol": {
        "strip": false
      }
    },
    "arkOptions": {
      "obfuscation": {
        "ruleOptions": {
          "enable": true,
          "files": [
            "./obfuscation-rules.txt"
          ]
        }
      }
    }
  }
}

// Ordinary public API only. No test helpers or diagnostic runtime are imported.
import { hilog } from '@kit.PerformanceAnalysisKit';
import { Runtime, BoundaryError, openRuntime } from @MADB_PUBLIC_MODULE@;
import { PROBE_NONCE } from '../ProbeConfig';
import { IDENTITY_CASE, IDENTITY_ERROR } from '../IdentityConfig';
import { check } from '../Assertions';
let started: boolean = false;
function emit(label: string, value: string): void {
  hilog.info(0x0000, 'MadBC07Probe', 'ORDINARY_IDENTITY_FRAME %{public}s %{public}s %{public}s', PROBE_NONCE, label, JSON.stringify(value));
}
async function rejectWrongLibrary(): Promise<void> {
  let opened: Runtime | undefined = undefined;
  emit('stage', 'ordinary-openRuntime-call');
  try { opened = openRuntime(); }
  catch (error) {
    check(error instanceof BoundaryError, 'ordinary-bootstrap-typed-error');
    const code: string = (error as BoundaryError).code;
    check(code === IDENTITY_ERROR, 'ordinary-bootstrap-exact-rejection:expected=' + IDENTITY_ERROR + ':actual=' + code);
    emit('rejected', code); return;
  }
  // An unexpectedly admitted runtime is really closed, then still fails the case.
  if (opened !== undefined) { await opened.close(); }
  throw new Error('LAB_ASSERT:wrong-library-openRuntime-was-admitted');
}
@Entry
@Component
struct Index {
  aboutToAppear(): void {
    if (started) { return; } started = true;
    hilog.info(0x0000, 'MadBC07Probe', 'PROBE_PAGE_READY %{public}s', PROBE_NONCE);
    hilog.info(0x0000, 'MadBC07Probe', 'ORDINARY_IDENTITY_BEGIN %{public}s %{public}s', PROBE_NONCE, IDENTITY_CASE);
    rejectWrongLibrary().then((): void => {
      hilog.info(0x0000, 'MadBC07Probe', 'ORDINARY_IDENTITY_COMPLETE %{public}s %{public}s', PROBE_NONCE, IDENTITY_CASE);
    }).catch((error: Error): void => {
      hilog.error(0x0000, 'MadBC07Probe', 'PROBE_FAILED %{public}s %{public}s', PROBE_NONCE, error.message);
    });
  }
  build() { Column() { Text('C07 ordinary wrong-library input') } }
}

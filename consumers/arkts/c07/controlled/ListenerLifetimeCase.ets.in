// Observe the actual subscription record's listener field, including after the
// user retains a closed wrapper. This is not a GC or per-listener NAPI-ref test.
import { Runtime, Engine, Subscription, Snapshot, testSubscriptionState,
  testHoldPublication, testReleasePublication, testDeliveryGate } from @MADB_PUBLIC_MODULE@;
import { check, nextTurn, throwsCode, snapshot } from './Assertions';
import { Emit, observed } from './SupportChecks';

function state(sub: Subscription, closing: number, closed: number, listener: number,
               label: string, emit: Emit): void {
  const values: number[] = testSubscriptionState(sub);
  check(values.length === 4 && values[0] === 1 && values[1] === closing &&
    values[2] === closed && values[3] === listener, label + ':actual-resource-record');
  emit(label, values);
}

export async function runListenerLifetime(runtime: Runtime, engine: Engine,
                                           deadline: number, emit: Emit): Promise<void> {
  let sourceCalls: number = 0;
  const source: Subscription = engine.observeEvents((_value: Snapshot): void => { sourceCalls++; });
  state(source, 0, 0, 1, 'listener-source-open', emit);
  testHoldPublication(engine, 1, { value: 1, text: 'source-held' });
  const held: number[] = observed(runtime, 'listener-source');
  check(held[8] === 1 && held[77] === 1 && held[6] === 1, 'listener-source:real-held-source');
  emit('listener-source-native', held);
  source.requestStop();
  let sourceClosed: boolean = false;
  const sourceClose: Promise<void> = source.close().then((): void => { sourceClosed = true; });
  await nextTurn(deadline, 'listener-source:wait-for-release');
  check(!sourceClosed && sourceCalls === 0, 'listener-source:pending-physical-close');
  state(source, 1, 0, 1, 'listener-source-retained', emit);
  throwsCode(() => { testReleasePublication(engine, 1); }, 'Closing', 'listener-source:stopped-source-aborts');
  await sourceClose;
  state(source, 1, 1, 0, 'listener-source-released', emit);

  let pendingCalls: number = 0;
  const pending: Subscription = engine.observeEvents((_value: Snapshot): void => { pendingCalls++; });
  testDeliveryGate(pending, 0);
  engine.publishEvent({ value: 2, text: 'preentry-held' });
  while (testDeliveryGate(pending, 1)[2] !== 1) { await nextTurn(deadline, 'listener-pending:real-lease'); }
  const queued: number[] = observed(runtime, 'listener-pending');
  check(queued[6] === 1 && queued[9] === 0 && pendingCalls === 0, 'listener-pending:not-entered');
  emit('listener-pending-native', queued);
  state(pending, 0, 0, 1, 'listener-pending-retained', emit);
  pending.requestStop();
  let pendingClosed: boolean = false;
  const pendingClose: Promise<void> = pending.close().then((): void => { pendingClosed = true; });
  await nextTurn(deadline, 'listener-pending:stop-before-entry');
  check(!pendingClosed && pendingCalls === 0, 'listener-pending:lease-keeps-close-pending');
  state(pending, 1, 0, 1, 'listener-pending-stopped', emit);
  testDeliveryGate(pending, 2); await pendingClose;
  state(pending, 1, 1, 0, 'listener-pending-released', emit);

  let enteredCalls: number = 0;
  let entered: Subscription | undefined = undefined;
  let enteredClose: Promise<void> | undefined = undefined;
  let enteredClosed: boolean = false;
  entered = engine.observeEvents((value: Snapshot): void => {
    enteredCalls++;
    check(entered !== undefined, 'listener-entered:wrapper-assigned');
    const sub: Subscription = entered as Subscription;
    const active: number[] = observed(runtime, 'listener-entered');
    check(active[5] === 1 && active[9] === 1, 'listener-entered:actual-entered-ticket');
    emit('listener-entry-native', active);
    state(sub, 0, 0, 1, 'listener-entry-retained', emit);
    sub.requestStop(); enteredClose = sub.close().then((): void => { enteredClosed = true; });
    check(!enteredClosed, 'listener-entered:wait-for-current-entry');
    state(sub, 1, 0, 1, 'listener-entry-stopped', emit);
    snapshot(value, 3, 'entered-copy', 'listener-entered:current-copy-survives-stop');
  });
  engine.publishEvent({ value: 3, text: 'entered-copy' });
  while (!enteredClosed) { await nextTurn(deadline, 'listener-entry:drain'); }
  if (enteredClose !== undefined) { await enteredClose; }
  check(entered !== undefined && sourceCalls === 0 && pendingCalls === 0 && enteredCalls === 1,
    'listener-lifetime:one-legal-entry');
  state(entered as Subscription, 1, 1, 0, 'listener-entry-released', emit);
  // Keep all three wrappers alive and inspect again: map removal alone cannot pass.
  state(source, 1, 1, 0, 'listener-source-still-released', emit);
  state(pending, 1, 1, 0, 'listener-pending-still-released', emit);
  emit('listener-lifetime-counts', [sourceCalls, pendingCalls, enteredCalls]);
  const drained: number[] = observed(runtime, 'listener-lifetime:drained');
  check(drained[5] === 0 && drained[6] === 0 && drained[8] === 0 && drained[9] === 0,
    'listener-lifetime:native-obligations-drained');
  emit('listener-lifetime-drained', drained);
}

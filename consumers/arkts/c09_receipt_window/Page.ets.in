import { hilog } from '@kit.PerformanceAnalysisKit';
import { BoundaryError } from @MADB_PUBLIC_MODULE@;
import { PROBE_NONCE } from '../ProbeConfig';
import { PROBE_CASE } from '../ProbeCase';
import { runReceiptWindow } from '../ReceiptWindow';
let started: boolean = false;
@Entry
@Component
struct Index {
  aboutToAppear(): void {
    if (started) { return; } started = true;
    hilog.info(0x0000, 'MadBC07Probe', 'PROBE_PAGE_READY %{public}s', PROBE_NONCE);
    runReceiptWindow(PROBE_CASE,
      (label: string, values: number[]): void => {
        hilog.info(0x0000, 'MadBC07Probe', 'C09_RECEIPT_FRAME %{public}s %{public}s %{public}s', PROBE_NONCE, label, JSON.stringify(values));
      }, (label: string, value: string): void => {
        hilog.info(0x0000, 'MadBC07Probe', 'C09_RECEIPT_FRAME %{public}s %{public}s %{public}s', PROBE_NONCE, label, JSON.stringify(value));
      }).then(() => {
        hilog.info(0x0000, 'MadBC07Probe', 'C09_RECEIPT_COMPLETE %{public}s', PROBE_NONCE);
      }).catch((error: Error) => {
        hilog.error(0x0000, 'MadBC07Probe', 'PROBE_FAILED %{public}s %{public}s %{public}s', PROBE_NONCE, error.message, String((error as BoundaryError).code));
      });
  }
  build() { Column() { Text('C09 after physical ACK before receipt') } }
}

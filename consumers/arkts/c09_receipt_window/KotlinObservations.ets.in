import { Runtime, testObserve, testSettleInspect, testLastAdmissionAudit } from @MADB_PUBLIC_MODULE@;
export const IS_KOTLIN: boolean = true;
export const REOPEN_CODE: string = 'AlreadyInitialized';
export function observe(runtime: Runtime): number[] { return testObserve(runtime); }
export function javascript(runtime: Runtime): number[] { return testSettleInspect(runtime); }
export function admission(): number[] { return testLastAdmissionAudit(); }
